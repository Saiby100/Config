font-family = JetBrainsMono Nerd Font
theme = One Double Dark

# No `command` override: ghostty opens a plain login shell. Start tmux by hand
# with `tmux attach` (or the `t` alias) when you want it. The .zshrc auto-launch
# was removed alongside this — leaving it would have put every ghostty window
# back into tmux regardless of what this file says.

# Make the Option key send Alt so Neovim's <A-...> keybinds work.
# `left` = left Option acts as Alt, right Option still types special chars
# (é, ¬, …). Use `true` if you want both Option keys to act as Alt.
macos-option-as-alt = left
